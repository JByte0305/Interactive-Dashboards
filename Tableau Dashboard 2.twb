      <column caption='Gross Profit' datatype='integer' name='[Calculation_1511618872164356]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1511618871234560])- SUM([Calculation_1511618871750658])' />
      </column>
      <column caption='Gross Profit %' datatype='real' name='[Calculation_1511618873913349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1511618872164356]/SUM([Calculation_1511618871234560])' />
      </column>
      <column caption='Revenue Variance %' datatype='real' name='[Calculation_1511618874191878]' role='measure' type='quantitative'>
